import type { ConfigContext, ExpoConfig } from 'expo/config';

type Variant = 'development' | 'staging' | 'production';

const variant = (process.env.APP_VARIANT ?? 'development') as Variant;

// APP_VARIANT (set per profile in eas.json) decides the app's identity. Runtime values such as
// the API URL come from .env.development / .env.production as EXPO_PUBLIC_ variables.
const byVariant: Record<Variant, { name: string; bundleId: string }> = {
  development: { name: '{{APP_NAME}} Dev', bundleId: '{{BUNDLE_ID}}.dev' },
  staging: { name: '{{APP_NAME}} Staging', bundleId: '{{BUNDLE_ID}}.staging' },
  production: { name: '{{APP_NAME}}', bundleId: '{{BUNDLE_ID}}' },
};

const env = byVariant[variant];

export default ({ config }: ConfigContext): ExpoConfig => ({
  ...config,
  name: env.name,
  slug: '{{APP_SLUG}}',
  ios: { ...config.ios, bundleIdentifier: env.bundleId },
  android: { ...config.android, package: env.bundleId },
  extra: {
    ...config.extra,
    appVariant: variant,
    eas: { projectId: process.env.EAS_PROJECT_ID ?? '' },
  },
});
