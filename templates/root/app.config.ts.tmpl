import type { ConfigContext, ExpoConfig } from 'expo/config';

type Variant = 'development' | 'staging' | 'production';

const variant = (process.env.APP_VARIANT ?? 'development') as Variant;

const byVariant: Record<Variant, { name: string; bundleId: string; apiBaseUrl: string }> = {
  development: { name: '{{APP_NAME}} Dev', bundleId: '{{BUNDLE_ID}}.dev', apiBaseUrl: 'https://api-dev.example.com' },
  staging: { name: '{{APP_NAME}} Staging', bundleId: '{{BUNDLE_ID}}.staging', apiBaseUrl: 'https://api-staging.example.com' },
  production: { name: '{{APP_NAME}}', bundleId: '{{BUNDLE_ID}}', apiBaseUrl: 'https://api.example.com' },
};

const env = byVariant[variant];

export default ({ config }: ConfigContext): ExpoConfig => ({
  ...config,
  name: env.name,
  slug: '{{APP_SLUG}}',
  ios: { ...config.ios, bundleIdentifier: env.bundleId },
  android: { ...config.android, package: env.bundleId },
  extra: {
    ...config.extra,
    appVariant: variant,
    apiBaseUrl: process.env.API_BASE_URL ?? env.apiBaseUrl,
{{#if crash}}
    sentryDsn: process.env.SENTRY_DSN ?? '',
{{/if}}
    eas: { projectId: process.env.EAS_PROJECT_ID ?? '' },
  },
});
