/* global jest */
const SILENCED = [/ProgressBarAndroid/, /Clipboard has been extracted/, /new NativeEventEmitter/];
const warn = console.warn;
console.warn = (...args) => {
  if (SILENCED.some((re) => re.test(String(args[0])))) return;
  warn(...args);
};

