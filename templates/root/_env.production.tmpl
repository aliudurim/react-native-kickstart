{{#if bare}}
# Production build ({{BUNDLE_ID}}). Baked in at build time by react-native-config:
# iOS Release configuration, Android `prod` flavor. Editing needs a native rebuild.
# Nothing here is secret: every value ships inside the app binary.
APP_ENV=prod
API_BASE_URL=https://api.example.com
DEEP_LINK_HOSTS={{APP_SLUG}}.example.com
{{#if crash}}
SENTRY_DSN=
{{/if}}
{{else}}
# Production build ({{BUNDLE_ID}}). Expo CLI loads this file when NODE_ENV=production
# (`expo start` → development, `expo export` and EAS production builds → production) and inlines
# every EXPO_PUBLIC_ value into the JS bundle. Keep it committed so EAS can read it.
# Nothing here is secret: every value ships inside the app bundle.
EXPO_PUBLIC_APP_ENV=prod
EXPO_PUBLIC_API_BASE_URL=https://api.example.com
EXPO_PUBLIC_DEEP_LINK_HOSTS={{APP_SLUG}}.example.com
{{#if crash}}
EXPO_PUBLIC_SENTRY_DSN=
{{/if}}
{{/if}}
