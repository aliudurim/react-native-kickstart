{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
{{#if expoRouter}}
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
{{else}}
  "include": ["**/*.ts", "**/*.tsx"],
{{/if}}
  "exclude": ["**/node_modules", "**/Pods", "ios", "android", "coverage"]
}
