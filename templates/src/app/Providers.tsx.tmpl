{{#if asyncStorage}}
import { useEffect, useState, type PropsWithChildren } from 'react'
{{else}}
import type { PropsWithChildren } from 'react'
{{/if}}
import { GestureHandlerRootView } from 'react-native-gesture-handler'
import { KeyboardProvider } from 'react-native-keyboard-controller'
import { SafeAreaProvider } from 'react-native-safe-area-context'
{{#if rtk}}
import { Provider as ReduxProvider } from 'react-redux'
{{/if}}
{{#if tanstack}}
import { QueryClientProvider } from '@tanstack/react-query'
{{/if}}
{{#if i18n}}
import { initI18n } from '@/i18n'
{{/if}}
{{#if tanstack}}
import { queryClient } from '@/lib/api/queryClient'
{{/if}}
import { initCrash } from '@/lib/crash'
{{#if noState}}
import { SessionProvider } from '@/lib/session'
{{/if}}
{{#if asyncStorage}}
import { hydrateStorage } from '@/lib/storage'
{{#if rtk}}
import { loadPersistedState, rehydrate } from '@/lib/storage/persist'
{{/if}}
{{/if}}
{{#if rtk}}
import { store } from '@/store/store'
{{/if}}
{{#if asyncStorage}}
{{#if zustand}}
import { useAuthStore } from '@/store/useAuthStore'
import { usePrefsStore } from '@/store/usePrefsStore'
{{/if}}
{{/if}}

initCrash()
{{#if i18n}}
initI18n()
{{/if}}

export function Providers({ children }: PropsWithChildren) {
{{#if asyncStorage}}
  const [ready, setReady] = useState(false)

  useEffect(() => {
    let cancelled = false
    void hydrateStorage().then(async () => {
{{#if rtk}}
      store.dispatch(rehydrate(loadPersistedState()))
{{/if}}
{{#if zustand}}
      await Promise.all([useAuthStore.persist.rehydrate(), usePrefsStore.persist.rehydrate()])
{{/if}}
      if (!cancelled) setReady(true)
    })
    return () => {
      cancelled = true
    }
  }, [])

  if (!ready) return null

{{/if}}
  return (
    <GestureHandlerRootView style={{ flex: 1 }}>
      <SafeAreaProvider>
{{#if rtk}}
        <ReduxProvider store={store}>
          <KeyboardProvider>{children}</KeyboardProvider>
        </ReduxProvider>
{{/if}}
{{#if tanstack}}
{{#if noState}}
        <SessionProvider>
          <QueryClientProvider client={queryClient}>
            <KeyboardProvider>{children}</KeyboardProvider>
          </QueryClientProvider>
        </SessionProvider>
{{else}}
        <QueryClientProvider client={queryClient}>
          <KeyboardProvider>{children}</KeyboardProvider>
        </QueryClientProvider>
{{/if}}
{{/if}}
{{#if plainFetch}}
{{#if noState}}
        <SessionProvider>
          <KeyboardProvider>{children}</KeyboardProvider>
        </SessionProvider>
{{else}}
        <KeyboardProvider>{children}</KeyboardProvider>
{{/if}}
{{/if}}
      </SafeAreaProvider>
    </GestureHandlerRootView>
  )
}
