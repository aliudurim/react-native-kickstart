import React from 'react';

import { Button, NavBar, Screen, Text } from '@/components';
import { useAuth } from '@/hooks/useAuth';
import { useTheme } from '@/theme';

export function ProfileScreen() {
  const theme = useTheme();
  const { user, signOut } = useAuth();
  return (
    <>
      <NavBar title="Profile" />
      <Screen edges={['left', 'right', 'bottom']} testID="profile-screen">
        <Text variant="title" accessibilityRole="header" style={{ marginTop: theme.spacing.lg }}>
          {user?.name || user?.email || 'Your profile'}
        </Text>
        {user?.email ? (
          <Text color="muted" style={{ marginTop: theme.spacing.xs }}>
            {user.email}
          </Text>
        ) : null}
        <Button title="Sign out" variant="secondary" onPress={signOut} style={{ marginTop: theme.spacing.xl }} testID="profile-sign-out" />
      </Screen>
    </>
  );
}
