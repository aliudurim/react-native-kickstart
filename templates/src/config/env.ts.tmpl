import { z } from 'zod'
{{#if bare}}
import Config from 'react-native-config'
{{else}}
import Constants from 'expo-constants'
{{/if}}

const envSchema = z.object({
  APP_ENV: z.enum(['prod', 'staging', 'dev']).default('dev'),
  API_BASE_URL: z.string().url(),
  DEEP_LINK_HOSTS: z
    .string()
    .default('')
    .transform((s) => s.split(',').map((h) => h.trim().toLowerCase()).filter(Boolean)),
  SENTRY_DSN: z.string().optional(),
})

export type Env = z.infer<typeof envSchema>

{{#if bare}}
const raw: Record<string, unknown> = { ...Config }
{{else}}
const raw: Record<string, unknown> = { ...(Constants.expoConfig?.extra ?? {}) }
{{/if}}

const parsed = envSchema.safeParse(raw)
if (!parsed.success) {
  throw new Error(`Invalid app environment: ${parsed.error.issues.map((i) => `${i.path.join('.')}: ${i.message}`).join('; ')}`)
}

export const env: Env = parsed.data
export const APP_NAME = '{{APP_NAME}}'
export const APP_SLUG = '{{APP_SLUG}}'
export const BUNDLE_ID = env.APP_ENV === 'prod' ? '{{BUNDLE_ID}}' : `{{BUNDLE_ID}}.${env.APP_ENV}`
export const isProd = env.APP_ENV === 'prod'
