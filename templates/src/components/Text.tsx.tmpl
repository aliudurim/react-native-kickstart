import React from 'react';
import { Text as RNText } from 'react-native';
import type { TextProps as RNTextProps } from 'react-native';
{{#if nativewind}}

import { cn } from '@/theme';
{{/if}}
{{#if unistyles}}
import { StyleSheet } from 'react-native-unistyles';
{{/if}}
{{#if stylesheet}}

import { useTheme } from '@/theme';
{{/if}}

export type TextVariant = 'title' | 'body' | 'caption' | 'label';
export type TextColor = 'foreground' | 'muted' | 'primary' | 'danger' | 'onPrimary';

export interface TextProps extends RNTextProps {
  variant?: TextVariant;
  color?: TextColor;
  align?: 'left' | 'center' | 'right';
{{#if nativewind}}
  className?: string;
{{/if}}
}
{{#if nativewind}}

const variantClass: Record<TextVariant, string> = {
  title: 'text-title font-bold',
  body: 'text-body font-normal',
  caption: 'text-caption font-normal',
  label: 'text-label font-semibold',
};

const colorClass: Record<TextColor, string> = {
  foreground: 'text-foreground dark:text-foreground-dark',
  muted: 'text-muted dark:text-muted-dark',
  primary: 'text-primary dark:text-primary-dark',
  danger: 'text-danger dark:text-danger-dark',
  onPrimary: 'text-onPrimary dark:text-onPrimary-dark',
};

export function Text({
  variant = 'body',
  color = variant === 'caption' ? 'muted' : 'foreground',
  align = 'left',
  className,
  style,
  ...rest
}: TextProps) {
  return (
    <RNText
      allowFontScaling
      maxFontSizeMultiplier={1.3}
      className={cn(variantClass[variant], colorClass[color], className)}
      style={[{ textAlign: align }, style]}
      {...rest}
    />
  );
}
{{/if}}
{{#if unistyles}}

export function Text({
  variant = 'body',
  color = variant === 'caption' ? 'muted' : 'foreground',
  align = 'left',
  style,
  ...rest
}: TextProps) {
  styles.useVariants({ variant, color });
  return (
    <RNText
      allowFontScaling
      maxFontSizeMultiplier={1.3}
      style={[styles.text, { textAlign: align }, style]}
      {...rest}
    />
  );
}

const styles = StyleSheet.create((theme) => ({
  text: {
    variants: {
      variant: {
        title: { fontSize: theme.fontSize.title, fontWeight: '700', lineHeight: theme.fontSize.title * 1.2 },
        body: { fontSize: theme.fontSize.body, fontWeight: '400', lineHeight: theme.fontSize.body * 1.5 },
        caption: { fontSize: theme.fontSize.caption, fontWeight: '400', lineHeight: theme.fontSize.caption * 1.4 },
        label: { fontSize: theme.fontSize.label, fontWeight: '600', lineHeight: theme.fontSize.label * 1.4 },
      },
      color: {
        foreground: { color: theme.colors.foreground },
        muted: { color: theme.colors.muted },
        primary: { color: theme.colors.primary },
        danger: { color: theme.colors.danger },
        onPrimary: { color: theme.colors.onPrimary },
      },
    },
  },
}));
{{/if}}
{{#if stylesheet}}

const weight: Record<TextVariant, '400' | '600' | '700'> = {
  title: '700',
  body: '400',
  caption: '400',
  label: '600',
};

const lineHeightRatio: Record<TextVariant, number> = { title: 1.2, body: 1.5, caption: 1.4, label: 1.4 };

export function Text({
  variant = 'body',
  color = variant === 'caption' ? 'muted' : 'foreground',
  align = 'left',
  style,
  ...rest
}: TextProps) {
  const theme = useTheme();
  const size = theme.fontSize[variant];
  return (
    <RNText
      allowFontScaling
      maxFontSizeMultiplier={1.3}
      style={[
        {
          fontSize: size,
          lineHeight: size * lineHeightRatio[variant],
          fontWeight: weight[variant],
          color: theme.colors[color],
          textAlign: align,
        },
        style,
      ]}
      {...rest}
    />
  );
}
{{/if}}
