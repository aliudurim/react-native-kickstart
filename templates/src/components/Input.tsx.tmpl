import React, { forwardRef } from 'react';
import { TextInput, View } from 'react-native';
import type { StyleProp, TextInputProps, ViewStyle } from 'react-native';
{{#if unistyles}}
import { StyleSheet } from 'react-native-unistyles';
{{/if}}

import { Text } from '@/components/Text';
{{#if nativewind}}
import { cn, useTheme } from '@/theme';
{{else}}
import { useTheme } from '@/theme';
{{/if}}

export interface InputProps extends Omit<TextInputProps, 'style'> {
  label: string;
  error?: string;
  rightSlot?: React.ReactNode;
  containerStyle?: StyleProp<ViewStyle>;
}

export const Input = forwardRef<React.ComponentRef<typeof TextInput>, InputProps>(function InputBase(
  { label, error, rightSlot, containerStyle, accessibilityLabel, editable = true, testID, ...rest },
  ref,
) {
  const theme = useTheme();
  const hasError = Boolean(error);
{{#if unistyles}}
  styles.useVariants({ state: hasError ? 'error' : undefined });
{{/if}}
  return (
    <View style={[{ gap: theme.spacing.xs }, containerStyle]}>
      <Text variant="label">{label}</Text>
      <View
{{#if nativewind}}
        className={cn(
          'rounded-md border bg-surface dark:bg-surface-dark',
          hasError ? 'border-danger dark:border-danger-dark' : 'border-border dark:border-border-dark',
        )}
        style={{ flexDirection: 'row', alignItems: 'center', minHeight: 48, opacity: editable ? 1 : 0.6 }}
{{/if}}
{{#if unistyles}}
        style={[styles.field, { opacity: editable ? 1 : 0.6 }]}
{{/if}}
{{#if stylesheet}}
        style={{
          flexDirection: 'row',
          alignItems: 'center',
          minHeight: 48,
          borderRadius: theme.radius.md,
          borderWidth: 1,
          borderColor: hasError ? theme.colors.danger : theme.colors.border,
          backgroundColor: theme.colors.surface,
          opacity: editable ? 1 : 0.6,
        }}
{{/if}}
      >
        <TextInput
          ref={ref}
          testID={testID}
          accessibilityLabel={accessibilityLabel ?? label}
          accessibilityState={{ disabled: !editable }}
          editable={editable}
          placeholderTextColor={theme.colors.muted}
          allowFontScaling
          maxFontSizeMultiplier={1.3}
{{#if nativewind}}
          className="text-body text-foreground dark:text-foreground-dark"
          style={{ flex: 1, paddingHorizontal: theme.spacing.md, paddingVertical: theme.spacing.sm, minHeight: 48 }}
{{/if}}
{{#if unistyles}}
          style={styles.input}
{{/if}}
{{#if stylesheet}}
          style={{
            flex: 1,
            paddingHorizontal: theme.spacing.md,
            paddingVertical: theme.spacing.sm,
            minHeight: 48,
            fontSize: theme.fontSize.body,
            color: theme.colors.foreground,
          }}
{{/if}}
          {...rest}
        />
        {rightSlot ? <View style={{ paddingRight: theme.spacing.xs }}>{rightSlot}</View> : null}
      </View>
      {hasError ? (
        <Text
          variant="caption"
          color="danger"
          accessibilityLiveRegion="polite"
          testID={testID ? `${testID}-error` : undefined}
        >
          {error}
        </Text>
      ) : null}
    </View>
  );
});
{{#if unistyles}}

const styles = StyleSheet.create((theme) => ({
  field: {
    flexDirection: 'row',
    alignItems: 'center',
    minHeight: 48,
    borderRadius: theme.radius.md,
    borderWidth: 1,
    backgroundColor: theme.colors.surface,
    variants: {
      state: {
        default: { borderColor: theme.colors.border },
        error: { borderColor: theme.colors.danger },
      },
    },
  },
  input: {
    flex: 1,
    paddingHorizontal: theme.spacing.md,
    paddingVertical: theme.spacing.sm,
    minHeight: 48,
    fontSize: theme.fontSize.body,
    color: theme.colors.foreground,
  },
}));
{{/if}}
